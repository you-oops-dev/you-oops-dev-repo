# Maintainer: Your Name <youremail@domain.com>
_pkgname=waybar-awg-toggle
pkgname=waybar-awg-toggle-git
pkgver=r8.edc9953
pkgrel=2
pkgdesc="A lightweight, high-performance Waybar plugin written in Rust for managing AmneziaWG (WireGuard protocol with obfuscation) connections."
arch=('any')
url="https://github.com/Mat1RX/waybar-awg-toggle"
license=('none')
depends=('amneziawg-tools')
makedepends=('cargo' 'upx')
optdepends=('amneziawg-dkms: AmneziaWG is a contemporary version of the popular VPN protocol, WireGuard.'
            'amneziawg-go: VPN amnezia WireGuard Golang userspace implementation.')
options=('!strip')
source=("git+${url}.git"
        "10-awg-toggle.rules")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
	cd "${srcdir}/${_pkgname}"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	cd "${srcdir}/${_pkgname}"
	cargo build --release
	upx -q --best --lzma "${srcdir}/${_pkgname}/target/release/awg-toggle" 2>/dev/null
}

package() {
	cd "${srcdir}/${_pkgname}" && mkdir -p "${pkgdir}/usr/bin/" "${pkgdir}/etc/polkit-1/rules.d/"

	install -D -m755 \
		"${srcdir}/${_pkgname}/target/release/awg-toggle" \
		"${pkgdir}/usr/bin/"

        install -D -m644 \
                "${srcdir}/10-awg-toggle.rules" \
                "${pkgdir}/etc/polkit-1/rules.d/"
}

